@model RequestLoanViewModel

@{
    ViewData["Title"] = "Request Loan";
}

<link rel="stylesheet" href="~/css/requestloan.css" asp-append-version="true" />

<div class="container loan-wrapper">

    <div class="w-100">

        <div class="brand-header">

            <div class="brand-badge">
                Business Funding
            </div>

            <h2 class="fw-bold">
                Request a Loan
            </h2>

            <p class="text-muted small mx-auto" style="max-width:520px;">
                Access funding based on your business transaction history
                and platform activity.
            </p>

        </div>

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="card loan-card">

                    <div class="card-body p-4 p-md-5">

                        @if (!string.IsNullOrWhiteSpace(Model.Message))
                        {
                            <div class="alert alert-warning mb-4">
                                @Model.Message
                            </div>
                        }

                        <div class="qualification-card">

                            <div class="qualification-label">
                                Maximum Loan Available
                            </div>

                            <div class="qualification-amount">
                                R @Model.AmountQualifyingFor.ToString("N2")
                            </div>

                        </div>

                        <div class="requirements-box">

                            <strong>Loan Requirements</strong>

                            <ul class="mt-2">
                                <li>Business must be active for at least 5 months.</li>
                                <li>Total deposits must be R5,000 or more.</li>
                                <li>Maximum loan amount is 35% of total deposits.</li>
                            </ul>

                        </div>
                        @if(Model.AmountQualifyingFor > 0)
                        {
                            <form asp-action="RequestLoan" method="post">

                                <div class="mb-3">

                                    <label asp-for="AmountRequested" class="form-label">
                                        Loan Amount Requested
                                    </label>

                                    <input asp-for="AmountRequested"
                                           class="form-control"
                                           placeholder="Enter amount" />

                                    <span asp-validation-for="AmountRequested"
                                          class="text-danger small"></span>

                                </div>

                                <button type="submit"
                                        class="btn btn-success btn-loan w-100">

                                    Submit Loan Request

                                </button>

                            </form>
                        }


                    </div>

                </div>

            </div>

        </div>

    </div>

</div>