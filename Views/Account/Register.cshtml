@model BusinessRegistrationViewModel

@{
    ViewData["Title"] = "Register Business";
}

<link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />

<div class="container register-wrapper">

    <div class="w-100">

        <!-- Header -->
        <div class="brand-header">

            <div class="brand-badge">
                Secure Business Onboarding
            </div>

            <h2 class="fw-bold">
                Register Your Business
            </h2>

            <p class="text-muted small mx-auto" style="max-width:520px;">
                Create your account to start building financial history, and accessing funding.
            </p>

        </div>

        <!-- Form Card -->
        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="card register-card">

                    <div class="card-body p-4 p-md-5">

                        <form asp-action="Register" method="post" enctype="multipart/form-data">

                            <!-- Business Name -->
                            <div class="mb-3">
                                <label class="form-label">Business Name</label>
                                <input asp-for="BusinessName" class="form-control" />
                                <span asp-validation-for="BusinessName" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="mb-3">
                                <label class="form-label">Email Address</label>
                                <input asp-for="EmailAddress" class="form-control" />
                                <span asp-validation-for="EmailAddress" class="text-danger small"></span>
                            </div>

                            <!-- Phone -->
                            <div class="mb-3">
                                <label class="form-label">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <!-- ID Number -->
                            <div class="mb-3">
                                <label class="form-label">ID Number</label>
                                <input asp-for="IdNumber" class="form-control" />
                                <span asp-validation-for="IdNumber" class="text-danger small"></span>
                            </div>

                            <!-- Password -->
                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <input asp-for="Password" type="password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Selfie Upload -->
                            <div class="mb-4">
                                <label class="form-label">ID + Selfie Photo</label>
                                <input asp-for="IdCardWithSelfie" type="file" class="form-control" />
                                <div class="helper-text mt-1">
                                    Take a clear photo of yourself holding your ID.
                                </div>
                                <span asp-validation-for="IdCardWithSelfie" class="text-danger small"></span>
                            </div>

                            <!-- Submit -->
                            <button type="submit" class="btn btn-success w-100">
                                Create Business Account
                            </button>

                            <p class="text-center mt-3 mb-0 helper-text">
                                Already registered?
                                <a asp-controller="Account" asp-action="Login">
                                    Sign in
                                </a>
                            </p>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>